# AWS Configuration
aws_region        = "us-east-1"
availability_zone = "us-east-1a"

# EC2 Configuration
instance_type     = "t3.micro"
instance_name     = "cloud-calendar-server"
environment       = "dev"

# Key Pair Configuration (WSL paths)
key_name        = "cloud-calendar-key"
public_key_path = "~/.ssh/cloud-calendar-key.pub"

# Storage Configuration
root_volume_size = 20

# Network Configuration
create_eip = false  # Set to true if you want a static IP
shut
x
^x
^X

